# Security boundary: never publish credentials, runtime state, or local stores.
# These rules are intentionally last so they override any broad allowlist above.
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*token*
**/*apikey*
**/*api_key*
**/auth.json
**/config.toml
**/hooks.json
**/*state*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite-*
**/*history*.jsonl
**/sessions/**
**/logs/**
**/cache/**
**/attachments/**
**/backups/**

# Structured Codex session packets are tracked evidence; derived indexes remain ignored.
!documentation/sessions/
!documentation/sessions/**
documentation/sessions/**/.rag/
documentation/sessions/**/.rag/**
