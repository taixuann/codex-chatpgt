# Franky control-plane Git uses an allowlist. Runtime and personal state stay ignored.
*
!.gitignore
!README.md
!AGENTS.md
!.github/
!.github/**
!documentation/
!documentation/**
!agents/
!agents/*.toml
!agents/README.md
!agents/CHANGELOG.md
!skills/
!skills/control-plane-audit/
!skills/control-plane-audit/**
!skills/runtime-adapter-management/
!skills/runtime-adapter-management/**
!skills/instruction-maintenance/
!skills/instruction-maintenance/**
!skills/project-bootstrap/
!skills/project-bootstrap/**
!skills/external-handoff/
skills/external-handoff/*
!skills/external-handoff/SKILL.md
!skills/external-handoff/agents/
!skills/external-handoff/agents/openai.yaml
!skills/shared-session-closeout/
!skills/shared-session-closeout/**
!skills/control-plane-audit/scripts/fixtures/
!skills/control-plane-audit/scripts/fixtures/session-valid.jsonl
!skills/control-plane-audit/scripts/fixtures/session-malformed.jsonl
!skills/control-plane-audit/scripts/fixtures/skill-routing.yaml
!workflows/
!workflows/AGENTS.md
!manifests/
!manifests/**
!ops/
!ops/schemas/
!ops/schemas/**
!ops/scripts/
!ops/scripts/**
!ops/schedulers/
!ops/schedulers/**
!ops/changes/
!ops/changes/**
!ops/on-demand-skills/
!ops/on-demand-skills/**
ops/on-demand-skills/install-project-link/*
ops/on-demand-skills/install-project-link/AGENTS.md
ops/on-demand-skills/install-project-link/assets/
ops/on-demand-skills/install-project-link/evals/
ops/on-demand-skills/install-project-link/references/
ops/on-demand-skills/install-project-link/skill.yaml
ops/on-demand-skills/install-project-link/templates/
!ops/on-demand-skills/install-project-link/SKILL.md
!ops/on-demand-skills/install-project-link/agents/
!ops/on-demand-skills/install-project-link/agents/openai.yaml
!ops/on-demand-skills/install-project-link/scripts/
ops/on-demand-skills/install-project-link/scripts/*
!ops/on-demand-skills/install-project-link/scripts/audit_link.py
!ops/on-demand-skills/install-project-link/scripts/create_project_link.py
!ops/on-demand-skills/install-project-link/tests/
ops/on-demand-skills/install-project-link/tests/*
!ops/on-demand-skills/install-project-link/tests/test_audit_link.py

# Security boundary: never publish credentials, runtime state, or local stores.
# These rules are intentionally last so they override any broad allowlist above.
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*token*
**/*apikey*
**/*api_key*
**/auth.json
**/config.toml
**/hooks.json
**/*state*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite-*
**/*history*.jsonl
**/sessions/**
**/logs/**
**/cache/**
**/attachments/**
**/backups/**
