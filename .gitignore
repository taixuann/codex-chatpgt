# Franky control-plane Git uses an allowlist. Runtime and personal state stay ignored.
*
!.gitignore
!README.md
!AGENTS.md
!.github/
!.github/**
!documentation/
!documentation/**
!agents/
!agents/*.toml
!agents/README.md
!agents/CHANGELOG.md
!skills/
!skills/franky-*/
!skills/franky-*/*
!skills/franky-*/*/*
!skills/project-bootstrap/
!skills/project-bootstrap/**
!skills/external-handoff/
skills/external-handoff/*
!skills/external-handoff/SKILL.md
!skills/external-handoff/agents/
!skills/external-handoff/agents/openai.yaml
!skills/install-project-link/
skills/install-project-link/*
!skills/install-project-link/SKILL.md
!skills/install-project-link/agents/
!skills/install-project-link/agents/openai.yaml
!skills/install-project-link/scripts/
!skills/install-project-link/scripts/audit_link.py
!skills/install-project-link/scripts/create_project_link.py
!skills/install-project-link/tests/
!skills/install-project-link/tests/test_audit_link.py
!skills/shared-session-closeout/
!skills/shared-session-closeout/**
!skills/franky-maintenance/scripts/fixtures/
!skills/franky-maintenance/scripts/fixtures/session-valid.jsonl
!skills/franky-maintenance/scripts/fixtures/session-malformed.jsonl
!workflows/
!workflows/franky/
!workflows/franky/*.yaml
!workflows/franky/franky-install/
!workflows/franky/franky-install/*.yaml
!workflows/franky/franky-maintenance/
!workflows/franky/franky-maintenance/*.yaml
!manifests/
!manifests/**
!ops/
!ops/schemas/
!ops/schemas/**
!ops/scripts/
!ops/scripts/**
!ops/schedulers/
!ops/schedulers/**
!ops/changes/
!ops/changes/**

# Security boundary: never publish credentials, runtime state, or local stores.
# These rules are intentionally last so they override any broad allowlist above.
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*token*
**/*apikey*
**/*api_key*
**/auth.json
**/config.toml
**/hooks.json
**/*state*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite-*
**/*history*.jsonl
**/sessions/**
**/logs/**
**/cache/**
**/attachments/**
**/backups/**
